FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    g++ \
    clang-format \
    clang-tidy \
    python3 \
    python3-pip \
    lcov \
    doxygen \
    graphviz \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir sphinx sphinx-rtd-theme

WORKDIR /app

COPY . /app

RUN mkdir -p build

WORKDIR /app/build
RUN cmake .. -G Ninja \
    -DCMAKE_BUILD_TYPE=Debug \
    -DBUILD_TESTING=ON \
    -DCODE_COVERAGE=ON

RUN ninja

RUN ctest --output-on-failure

RUN ninja coverage || true

RUN ninja docs || true

CMD ["ctest", "--output-on-failure"]